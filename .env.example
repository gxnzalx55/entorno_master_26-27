# Copia este archivo como .env (en la misma carpeta que docker-compose.yml).
# Docker y los scripts de Python leen de aquí usuarios, contraseñas y puertos.

# ---------- PostgreSQL + pgAdmin ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=northwind2026
POSTGRES_DB=northwind
# Si ya tienes un PostgreSQL usando el 5432 en tu ordenador, cambia a 5433
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
PGADMIN_PORT=5050

# ---------- MongoDB + mongo-express ----------
# Son el usuario y la contraseña que usan los scripts de la carpeta MongoDB
# (mongodb://root:example1@localhost:27017/). Si los cambias, cambia también los scripts.
MONGO_USER=root
MONGO_PASSWORD=example1
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# ---------- Redis ----------
REDIS_PORT=6379
